# pi-gate Configuration Example
# Copy this file to .env and modify as needed

# DNS Server Configuration
PI_GATE_DNS_HOST=0.0.0.0
PI_GATE_DNS_PORT=53

# Dashboard Configuration
PI_GATE_DASHBOARD_HOST=0.0.0.0
PI_GATE_DASHBOARD_PORT=8050

# Upstream DNS Server
PI_GATE_UPSTREAM_DNS=8.8.8.8:53

# Blocklist URL
PI_GATE_BLOCKLIST_URL=https://raw.githubusercontent.com/hagezi/dns-blocklists/main/hosts/pro.txt

# Logging Level (DEBUG, INFO, WARNING, ERROR)
PI_GATE_LOG_LEVEL=INFO 